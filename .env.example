# Copy to .env.local and fill in from your Supabase project's Settings > API
# page. Both are required for the app to use Supabase (data sync + phone
# auth) — if either is unset, the app falls back to mock data + local
# AsyncStorage persistence and skips the auth gate entirely (dev mode). See
# CLAUDE.md "Supabase (optional backend)" for setup steps.
#
# Phone auth additionally requires Auth → Providers → Phone enabled on the
# project, with Twilio configured as the SMS provider.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog project API key from Project Settings > API Keys. If unset, analytics
# is a no-op (src/lib/analytics.ts). EXPO_PUBLIC_POSTHOG_HOST defaults to
# PostHog Cloud US; set it for EU Cloud or a self-hosted instance.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry project DSN from Settings > Projects > <project> > Client Keys (DSN).
# If unset, crash reporting is a no-op (src/lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=

# Spotify app Client ID (developer.spotify.com/dashboard > your app > Settings).
# Used for an in-app Authorization Code + PKCE flow (public client, no secret
# needed) — add "knowable://spotify-auth-callback" as a Redirect URI on the
# Spotify app. If unset, the Spotify data-pull card falls back to the
# simulated dev pull, same as every other still-simulated source
# (src/data/adapters/spotify.ts).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# Strava app Client ID + Client Secret (strava.com/settings/api). Used for an
# in-app Authorization Code OAuth flow — add "knowable://strava-auth-callback"
# as the Authorization Callback Domain on the Strava app. Unlike Spotify,
# Strava's token endpoint requires the Client Secret on every exchange/refresh
# (no PKCE-only option), so both vars are needed; it ships in the app bundle
# like any EXPO_PUBLIC_* var, same trade-off every mobile Strava integration
# makes absent a backend. If either is unset, the Strava data-pull card falls
# back to the simulated dev pull (src/data/adapters/strava.ts).
EXPO_PUBLIC_STRAVA_CLIENT_ID=
EXPO_PUBLIC_STRAVA_CLIENT_SECRET=
