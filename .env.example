# Copy to .env.local and fill in from your Supabase project's Settings > API
# page. Both are required for the app to use Supabase — if either is unset,
# the app falls back to mock data + local AsyncStorage persistence (dev mode).
# See CLAUDE.md "Supabase (optional backend)" for setup steps.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
