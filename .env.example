# Copy to .env.local and fill in from your Supabase project's Settings > API
# page. Both are required for the app to use Supabase (data sync + phone
# auth) — if either is unset, the app falls back to mock data + local
# AsyncStorage persistence and skips the auth gate entirely (dev mode). See
# CLAUDE.md "Supabase (optional backend)" for setup steps.
#
# Phone auth additionally requires Auth → Providers → Phone enabled on the
# project, with Twilio configured as the SMS provider.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog project API key from Project Settings > API Keys. If unset, analytics
# is a no-op (src/lib/analytics.ts). EXPO_PUBLIC_POSTHOG_HOST defaults to
# PostHog Cloud US; set it for EU Cloud or a self-hosted instance.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Sentry project DSN from Settings > Projects > <project> > Client Keys (DSN).
# If unset, crash reporting is a no-op (src/lib/sentry.ts).
EXPO_PUBLIC_SENTRY_DSN=
